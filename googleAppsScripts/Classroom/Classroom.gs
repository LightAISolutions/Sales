var CL_DRILL_TAB = 'ClassroomDrill';
var CL_DRILL_LOG_TAB = 'ClassroomDrillLog';
var CL_DRILL_HEADERS = ['Account', 'ItemId', 'Hash', 'Ease', 'IntervalDays',
